# Public, canonical site URL used for canonical links, sitemap, robots, and OG image URLs.
# Use your Vercel URL first, then replace it with your final custom domain. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# MongoDB — persistent likes, requests, and first-party analytics.
MONGODB_URI=
MONGODB_DB_NAME=portfolio-project

# Private analytics dashboard. Use a long, random value; never expose it in a public URL.
ANALYTICS_DASHBOARD_TOKEN=

# Request notification emails via Resend. RESEND_FROM_EMAIL must use a verified sender/domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional Google Analytics measurement ID, for example G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=

# Ask Kiki. Keep false until OpenAI billing is enabled and an API key is configured.
NEXT_PUBLIC_ASK_KIKI_ENABLED=false
OPENAI_API_KEY=
# Optional: leave blank to use the app default model.
OPENAI_MODEL=
